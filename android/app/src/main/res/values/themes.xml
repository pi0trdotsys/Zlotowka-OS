<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Zlotowka" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="Theme.Zlotowka.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_icon_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mascot</item>
        <item name="windowSplashScreenAnimationDuration">900</item>
        <item name="postSplashScreenTheme">@style/Theme.Zlotowka</item>
    </style>
</resources>
